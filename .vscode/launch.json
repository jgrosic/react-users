{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch the app",
            "request": "launch",
            "type": "msedge",
            "url": "http://localhost:5000",
            "webRoot": "${workspaceFolder}/users-directory",
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            // start-up debugging
            "preLaunchTask": "Start Vite Server",

            // skip debugging framework code, similar to "Just my code" in .NET debugging
            "skipFiles": [
                "${workspaceFolder}/node_modules/**/*", // skip libraries (React, Router, itd.)
                "<node_internals>/**", // skip internal node processes
                "**/node_modules/**", // skip external modules served by Vite
                "vscode-webview:///**", // skip vscode scripts
                "chrome-extension:///**", // skip chrome extensions
                "extension:///**", // skip extension altogether
                "**/proxy.js",
                "**/installHook.js"
            ]
        }
    ]
}